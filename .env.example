# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=eco_energy_solution_db

# Session Configuration
SESSION_SECRET=your_secure_random_secret_here

# Server Configuration
PORT=3000

# Note for Hostinger Deployment:
# 1. Create a .env file (copy from this .env.example)
# 2. Update the DB_* values with your actual Hostinger MySQL credentials
# 3. Generate a secure random string for SESSION_SECRET
# 4. If Hostinger assigns a specific port, update PORT accordingly
# 5. Make sure .env is NOT tracked in git (add to .gitignore)
