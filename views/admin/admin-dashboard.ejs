<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard – Eco Green Energy</title>
  <!-- Bootstrap 5 CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    :root { --eco: #2e7d32; --eco-dark: #1b5e20; --eco-light: #e8f5e9; }
    body { background: #f5f7f5; font-size: 0.9rem; }

    /* ---- Sidebar ---- */
    .sidebar {
      width: 240px;
      min-height: 100vh;
      background: var(--eco-dark);
      position: fixed;
      top: 0; left: 0;
      display: flex;
      flex-direction: column;
      z-index: 100;
    }
    .sidebar .brand {
      padding: 1.4rem 1.2rem 1rem;
      border-bottom: 1px solid rgba(255,255,255,0.12);
    }
    .sidebar .brand h5 {
      color: #fff;
      margin: 0;
      font-weight: 700;
      font-size: 0.95rem;
      line-height: 1.4;
    }
    .sidebar .brand small { color: #a5d6a7; font-size: 0.75rem; }
    .sidebar .nav-link {
      color: #c8e6c9;
      padding: 0.7rem 1.2rem;
      font-size: 0.88rem;
      border-left: 3px solid transparent;
      transition: all 0.18s;
    }
    .sidebar .nav-link:hover,
    .sidebar .nav-link.active {
      color: #fff;
      background: rgba(255,255,255,0.08);
      border-left-color: #81c784;
    }
    .sidebar .nav-link .icon { margin-right: 8px; font-size: 1rem; }
    .sidebar-footer {
      margin-top: auto;
      padding: 1rem 1.2rem;
      border-top: 1px solid rgba(255,255,255,0.12);
    }

    /* ---- Main content ---- */
    .main-content {
      margin-left: 240px;
      padding: 0;
      min-height: 100vh;
    }
    .topbar {
      background: #fff;
      border-bottom: 1px solid #dee2e6;
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }
    .topbar .page-title { font-weight: 700; color: var(--eco-dark); font-size: 1.05rem; }
    .topbar .admin-badge {
      background: var(--eco-light);
      color: var(--eco-dark);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    /* ---- Stat cards ---- */
    .stat-card {
      border: none;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }
    .stat-card .icon-box {
      width: 52px; height: 52px;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem;
    }

    /* ---- Tables ---- */
    .section-card {
      border: none;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
      margin-bottom: 2rem;
    }
    .section-card .card-header {
      background: var(--eco);
      color: #fff;
      border-radius: 10px 10px 0 0 !important;
      font-weight: 600;
      padding: 0.85rem 1.2rem;
    }
    .table thead th {
      background: var(--eco-light);
      color: var(--eco-dark);
      font-weight: 600;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      border-bottom: 2px solid #c8e6c9;
      white-space: nowrap;
    }
    .table-hover tbody tr:hover { background-color: #f1f8f1; }
    .table td { vertical-align: middle; max-width: 220px; }
    .msg-cell {
      max-width: 220px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .badge-service {
      background: var(--eco-light);
      color: var(--eco-dark);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 20px;
    }
    .empty-row td { text-align: center; color: #888; padding: 2rem; }

    /* ---- Responsive ---- */
    @media (max-width: 768px) {
      .sidebar { width: 100%; min-height: auto; position: relative; }
      .main-content { margin-left: 0; }
    }
  </style>
</head>
<body>

<!-- ===================== SIDEBAR ===================== -->
<div class="sidebar">
  <div class="brand">
    <div style="font-size:1.6rem; margin-bottom:6px;">🌿</div>
    <h5>Eco Green Energy<br/>Solution (Pvt) Ltd</h5>
    <small>Admin Panel</small>
  </div>

  <nav class="mt-2">
    <a href="#contacts-section" class="nav-link active">
      <span class="icon">📋</span> Contact Inquiries
    </a>
    <a href="#quotes-section" class="nav-link">
      <span class="icon">📝</span> Quote Requests
    </a>
    <% if (adminRole === 'superadmin') { %>
      <div style="border-top:1px solid rgba(255,255,255,.1); margin:0.5rem 1.2rem;"></div>
      <a href="/admin/register" class="nav-link">
        <span class="icon">➕</span> Register Admin
      </a>
      <a href="/admin/manage-admins" class="nav-link">
        <span class="icon">👥</span> Manage Admins
      </a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div style="color:#a5d6a7; font-size:0.78rem; margin-bottom:8px;">
      Logged in as <strong style="color:#fff;"><%= adminUser %></strong>
      <span class="badge ms-1" style="background:rgba(255,255,255,.15); font-size:.7rem;"><%= adminRole %></span>
    </div>
    <a href="/" class="btn btn-sm btn-outline-light w-100 mb-2" style="opacity:.75;">🌐 Back to Website</a>
    <a href="/admin/logout" class="btn btn-sm btn-outline-light w-100">🚪 Logout</a>
  </div>
</div>

<!-- ===================== MAIN CONTENT ===================== -->
<div class="main-content">

  <!-- Top bar -->
  <div class="topbar">
    <span class="page-title">📊 Admin Dashboard</span>
    <span class="admin-badge">👤 <%= adminUser %></span>
  </div>

  <div class="p-4">

    <!-- ---- Stat Summary Cards ---- -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3">
        <div class="card stat-card p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box" style="background:#e8f5e9;">📋</div>
            <div>
              <div class="text-muted" style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.5px;">Total Contacts</div>
              <div style="font-size:1.8rem; font-weight:700; color:#2e7d32; line-height:1.2;"><%= contacts.length %></div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card stat-card p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box" style="background:#e3f2fd;">📝</div>
            <div>
              <div class="text-muted" style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.5px;">Quote Requests</div>
              <div style="font-size:1.8rem; font-weight:700; color:#1565c0; line-height:1.2;"><%= quotes.length %></div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card stat-card p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box" style="background:#fff3e0;">📅</div>
            <div>
              <div class="text-muted" style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.5px;">Today's Date</div>
              <div style="font-size:1rem; font-weight:600; color:#e65100; line-height:1.5; margin-top:2px;">
                <%= new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}) %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card stat-card p-3">
          <div class="d-flex align-items-center gap-3">
            <div class="icon-box" style="background:#f3e5f5;">📊</div>
            <div>
              <div class="text-muted" style="font-size:0.78rem; text-transform:uppercase; letter-spacing:0.5px;">Total Records</div>
              <div style="font-size:1.8rem; font-weight:700; color:#6a1b9a; line-height:1.2;"><%= contacts.length + quotes.length %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- /Stat cards -->

    <!-- ===================== CONTACTS TABLE ===================== -->
    <div class="card section-card" id="contacts-section">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span>📋 Contact Inquiries</span>
        <span class="badge bg-light text-dark"><%= contacts.length %> records</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th style="width:50px;">#</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Message</th>
                <th>Received At</th>
              </tr>
            </thead>
            <tbody>
              <% if (contacts.length === 0) { %>
                <tr class="empty-row"><td colspan="6">No contact inquiries yet.</td></tr>
              <% } else { %>
                <% contacts.forEach(function(c, i) { %>
                  <tr>
                    <td class="text-muted"><%= i + 1 %></td>
                    <td><strong><%= c.name %></strong></td>
                    <td><a href="mailto:<%= c.email %>" class="text-decoration-none"><%= c.email %></a></td>
                    <td><%= c.phone || '—' %></td>
                    <td class="msg-cell" title="<%= c.message %>"><%= c.message %></td>
                    <td class="text-muted" style="white-space:nowrap;">
                      <%= c.created_at ? new Date(c.created_at).toLocaleString('en-GB', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—' %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div><!-- /table-responsive -->
      </div>
    </div>
    <!-- /Contacts table -->

    <!-- ===================== QUOTES TABLE ===================== -->
    <div class="card section-card" id="quotes-section">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span>📝 Quote Requests</span>
        <span class="badge bg-light text-dark"><%= quotes.length %> records</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th style="width:50px;">#</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Service</th>
                <th>Preferred Date</th>
                <th>Time</th>
                <th>Message</th>
                <th>Received At</th>
              </tr>
            </thead>
            <tbody>
              <% if (quotes.length === 0) { %>
                <tr class="empty-row"><td colspan="9">No quote requests yet.</td></tr>
              <% } else { %>
                <% quotes.forEach(function(q, i) { %>
                  <tr>
                    <td class="text-muted"><%= i + 1 %></td>
                    <td><strong><%= q.name %></strong></td>
                    <td><a href="mailto:<%= q.email %>" class="text-decoration-none"><%= q.email %></a></td>
                    <td><%= q.phone || '—' %></td>
                    <td><span class="badge-service"><%= q.service || '—' %></span></td>
                    <td style="white-space:nowrap;">
                      <%= q.preferred_date ? new Date(q.preferred_date).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) : '—' %>
                    </td>
                    <td><%= q.preferred_time || '—' %></td>
                    <td class="msg-cell" title="<%= q.message %>"><%= q.message || '—' %></td>
                    <td class="text-muted" style="white-space:nowrap;">
                      <%= q.created_at ? new Date(q.created_at).toLocaleString('en-GB', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—' %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div><!-- /table-responsive -->
      </div>
    </div>
    <!-- /Quotes table -->

  </div><!-- /p-4 -->
</div><!-- /main-content -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
