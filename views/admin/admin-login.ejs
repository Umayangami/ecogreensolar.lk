<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login – Eco Green Energy</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    body {
      background: linear-gradient(135deg, #1a3c1a 0%, #2e7d32 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-card {
      width: 100%;
      max-width: 420px;
      border: none;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    }
    .login-card .card-header {
      background: #2e7d32;
      border-radius: 12px 12px 0 0;
      text-align: center;
      padding: 1.5rem;
    }
    .login-card .card-header h4 { color:#fff; margin:0; font-weight:700; letter-spacing:.5px; }
    .login-card .card-header small { color:#a5d6a7; font-size:.82rem; }
    .leaf-icon { font-size:2.4rem; margin-bottom:.4rem; }
    .btn-login { background:#2e7d32; border:none; color:#fff; font-weight:600; letter-spacing:.4px; transition:background .2s; }
    .btn-login:hover { background:#1b5e20; color:#fff; }
    .form-control:focus { border-color:#2e7d32; box-shadow:0 0 0 .2rem rgba(46,125,50,.25); }
  </style>
</head>
<body>

  <div class="card login-card">
    <div class="card-header">
      <div class="leaf-icon">🌿</div>
      <h4>Eco Green Energy</h4>
      <small>Admin Panel Login</small>
    </div>

    <div class="card-body p-4">

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
          <small><%= error %></small>
          <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
          <small><%= success %></small>
          <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label fw-semibold">Username</label>
          <input type="text" id="username" name="username" class="form-control"
            placeholder="Enter admin username" autocomplete="username" required autofocus />
        </div>
        <div class="mb-4">
          <label for="password" class="form-label fw-semibold">Password</label>
          <input type="password" id="password" name="password" class="form-control"
            placeholder="Enter password" autocomplete="current-password" required />
        </div>
        <div class="d-grid">
          <button type="submit" class="btn btn-login btn-lg">Login</button>
        </div>
      </form>

    </div>

    <div class="card-footer text-center text-muted py-3" style="border-radius:0 0 12px 12px;">
      <a href="/"
         style="display:inline-flex;align-items:center;gap:6px;color:#555;text-decoration:none;font-size:.82rem;transition:color .2s;"
         onmouseover="this.style.color='#2e7d32';"
         onmouseout="this.style.color='#555';">
        ← Back to Website
      </a>
      <div class="mt-1" style="font-size:.75rem;">
        &copy; <%= new Date().getFullYear() %> Eco Green Energy Solution (Pvt) Ltd
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
