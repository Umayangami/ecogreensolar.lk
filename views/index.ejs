    <div id="customBgSlider" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; background-color: #000;">
        <!-- Image 1 (Meka mulinma penawa - opacity: 1) -->
        <img src="/images/banner/image1.jpeg" class="slider-img" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 1; transition: opacity 1s ease-in-out;" alt="Solar 1">
        
        <!-- Image 2 (Meka hangila thiyenne - opacity: 0) -->
        <img src="/images/banner/image2.jpg" class="slider-img" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1s ease-in-out;" alt="Solar 2">
        
