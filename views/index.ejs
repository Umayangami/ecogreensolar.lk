        <img src="/images/banner/image3.jpg" class="slider-img" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1s ease-in-out;" alt="Solar 3">
    </div>

    <!-- Podi JS Kalla Slider eka run karanna -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('#customBgSlider .slider-img');
            let currentIndex = 0;

            if(images.length > 0) {
                setInterval(() => {
                    // Dan penna thiyena image eka fade out karanawa
                    images[currentIndex].style.opacity = '0';
                    
                    // Ilaga image ekata yanawa (3ta passe aith 1ta enawa)
                    currentIndex = (currentIndex + 1) % images.length;
                    
                    // Aluth image eka fade in karanawa
                    images[currentIndex].style.opacity = '1';
                }, 4000); // 4000 = Thathpara 4n 4ta maru wenawa
            }
        });
    </script>

